<Window x:Class="eyesharp.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:eyesharp.Views"
        Title="EyeSharp 数据统计" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResize"
        MinWidth="700" MinHeight="500">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.2" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="10,15,10,5" />
        </Style>

        <!-- 刷新按钮样式 -->
        <Style x:Key="RefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 导出按钮样式 -->
        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 热力图单元格样式 -->
        <Style x:Key="HeatmapCellStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
        </Style>

        <local:IsCompletedConverter x:Key="IsCompletedConverter" />
        <local:IsForcedModeConverter x:Key="IsForcedModeConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="24" Margin="0,0,10,0" />
                    <TextBlock Text="数据统计" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 刷新" Width="90" Height="36"
                        Style="{StaticResource RefreshButtonStyle}"
                        Click="RefreshButton_Click" />
            </Grid>
        </Border>

        <!-- TabControl 标签页 -->
        <TabControl Grid.Row="1" Margin="10" BorderThickness="0" Background="Transparent">
            <!-- 护眼统计标签页 -->
            <TabItem Header="👁 护眼统计">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 统计卡片区域 -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                        <StackPanel>
                            <!-- 今日统计 -->
                            <TextBlock Text="今日统计" Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="TodayCountText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="休息次数" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="TodayDurationText" Text="0分" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="总休息时长" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="TodayCompletedText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="正常完成" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="TodaySkippedText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="提前结束" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 本周统计 -->
                            <TextBlock Text="本周统计" Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="WeekCountText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="休息次数" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="WeekDurationText" Text="0分" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="总休息时长" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="WeekCompletedText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="正常完成" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="WeekSkippedText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="提前结束" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 本月统计 -->
                            <TextBlock Text="本月统计" Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="MonthCountText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="休息次数" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="MonthDurationText" Text="0分" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="总休息时长" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="MonthCompletedText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="正常完成" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="MonthSkippedText" Text="0" Style="{StaticResource StatValueStyle}" />
                                        <TextBlock Text="提前结束" Style="{StaticResource StatLabelStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 最近记录表格 -->
                    <Border Grid.Row="1" Margin="10,5,10,10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题栏和筛选控件 -->
                            <Grid Grid.Row="0" Margin="15,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="休息记录明细" FontSize="16" FontWeight="SemiBold"
                                          VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />

                                <!-- 日期筛选 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="从" VerticalAlignment="Center" Margin="0,0,5,0"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <DatePicker x:Name="StartDatePicker" Width="120" Margin="0,0,10,0"
                                               SelectedDateChanged="DatePicker_SelectedDateChanged" />
                                    <TextBlock Text="至" VerticalAlignment="Center" Margin="0,0,5,0"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <DatePicker x:Name="EndDatePicker" Width="120" Margin="0,0,10,0"
                                               SelectedDateChanged="DatePicker_SelectedDateChanged" />
                                    <Button Content="本周" Width="50" Height="26" Margin="0,0,5,0"
                                            Background="{DynamicResource PrimaryBrush}" Foreground="White"
                                            BorderThickness="0" Click="WeekFilterButton_Click" />
                                    <Button Content="本月" Width="50" Height="26"
                                            Background="{DynamicResource PrimaryBrush}" Foreground="White"
                                            BorderThickness="0" Click="MonthFilterButton_Click" />
                                </StackPanel>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="RecordsDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      HeadersVisibility="Column"
                                      RowHeight="35"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="10">
                                <DataGrid.Resources>
                                    <!-- 表头样式 -->
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    </Style>
                                    <!-- 单元格样式 -->
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <!-- 行样式 -->
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                                    <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                                    <DataGridTextColumn Header="计划时长" Binding="{Binding PlannedDurationSeconds, StringFormat={}{0}秒}" Width="80" />
                                    <DataGridTextColumn Header="实际时长" Binding="{Binding DurationSeconds, StringFormat={}{0}秒}" Width="80" />
                                    <DataGridTextColumn Header="状态" Width="100" Binding="{Binding IsCompleted, Converter={StaticResource IsCompletedConverter}}" />
                                    <DataGridTextColumn Header="模式" Width="80" Binding="{Binding IsForcedMode, Converter={StaticResource IsForcedModeConverter}}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 分页控件 -->
                            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                     Background="{DynamicResource CardBackgroundBrush}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="PaginationInfoText"
                                              Text="共 0 条记录"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="PrevPageButton" Content="◀ 上一页" Width="70" Height="26"
                                                Margin="0,0,5,0" Click="PrevPageButton_Click"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" />
                                        <TextBlock x:Name="PageNumberText" Text="第 1 页"
                                                  VerticalAlignment="Center" Margin="10,0"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Button x:Name="NextPageButton" Content="下一页 ▶" Width="70" Height="26"
                                                Margin="5,0,0,0" Click="NextPageButton_Click"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 电脑使用统计标签页 -->
            <TabItem Header="💻 电脑使用">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 今日概览 -->
                    <TextBlock Grid.Row="0" Text="今日概览" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 开机时长 -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="⏱️" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TodayBootTimeText" Text="0小时0分" Style="{StaticResource StatValueStyle}" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="开机时长" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 活跃时间 -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="⌨️" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TodayActiveTimeText" Text="0小时0分" Style="{StaticResource StatValueStyle}" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="活跃时间" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 空闲时间 -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="☕" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TodayIdleTimeText" Text="0小时0分" Style="{StaticResource StatValueStyle}" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="空闲时间" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 锁屏次数 -->
                        <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TodayLockScreenCountText" Text="0" Style="{StaticResource StatValueStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="锁屏次数" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 输入统计 -->
                            <TextBlock Text="输入统计" Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 键盘按键 -->
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⌨️" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TodayKeyPressCountText" Text="0" Style="{StaticResource StatValueStyle}" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="按键次数" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 鼠标移动 -->
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🖱️" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TodayMouseMoveText" Text="0米" Style="{StaticResource StatValueStyle}" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="鼠标移动" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 鼠标点击 -->
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="🖱️" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TodayMouseClickText" Text="0" Style="{StaticResource StatValueStyle}" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="点击次数" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 滚轮滚动 -->
                                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="📜" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TodayMouseWheelText" Text="0" Style="{StaticResource StatValueStyle}" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="滚轮次数" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 24小时活跃热力图 -->
                            <TextBlock Text="24小时活跃热力图" Style="{StaticResource SectionTitleStyle}" />

                            <Border Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <!-- 图例 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                            <Border Width="16" Height="16" Background="#E3F2FD" CornerRadius="3" />
                                            <TextBlock Text="空闲" FontSize="12" Margin="5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                            <Border Width="16" Height="16" Background="#90CAF9" CornerRadius="3" />
                                            <TextBlock Text="低活跃" FontSize="12" Margin="5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                            <Border Width="16" Height="16" Background="#42A5F5" CornerRadius="3" />
                                            <TextBlock Text="中活跃" FontSize="12" Margin="5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                            <Border Width="16" Height="16" Background="#1565C0" CornerRadius="3" />
                                            <TextBlock Text="高活跃" FontSize="12" Margin="5,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 热力图网格 -->
                                    <Grid x:Name="HourlyHeatmapGrid" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 本周概览 -->
                            <TextBlock Text="本周概览" Style="{StaticResource SectionTitleStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="WeekActiveTimeText" Text="0小时0分" Style="{StaticResource StatValueStyle}" FontSize="24" HorizontalAlignment="Center" />
                                        <TextBlock Text="本周活跃" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="WeekAvgDailyText" Text="0小时0分" Style="{StaticResource StatValueStyle}" FontSize="24" HorizontalAlignment="Center" />
                                        <TextBlock Text="日均使用" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="WeekTotalInputText" Text="0" Style="{StaticResource StatValueStyle}" FontSize="24" HorizontalAlignment="Center" />
                                        <TextBlock Text="总输入次数" Style="{StaticResource StatLabelStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 最近7天数据表格 -->
                            <Border Style="{StaticResource CardStyle}" Margin="10,10,10,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="最近7天使用记录" FontSize="16" FontWeight="SemiBold"
                                              Margin="15,10" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <DataGrid Grid.Row="1" x:Name="DailyUsageDataGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              HeadersVisibility="Column"
                                              RowHeight="35"
                                              Background="{DynamicResource CardBackgroundBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Margin="10">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Padding" Value="10,5" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Padding" Value="10,5" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100" />
                                            <DataGridTextColumn Header="开机时长" Binding="{Binding BootTime}" Width="90" />
                                            <DataGridTextColumn Header="活跃时间" Binding="{Binding ActiveTime}" Width="90" />
                                            <DataGridTextColumn Header="锁屏次数" Binding="{Binding LockScreenCount}" Width="80" />
                                            <DataGridTextColumn Header="按键次数" Binding="{Binding KeyPressCount}" Width="80" />
                                            <DataGridTextColumn Header="鼠标移动" Binding="{Binding MouseMove}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
